# Supabase Connect > Transaction pooler (runtime / Vercel serverless).
# Copy your exact host/user from Supabase; URL-encode the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Supabase Connect > Session pooler (migrations; supports IPv4).
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# Local: http://localhost:3000. Vercel: your actual https production domain.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Only needed when explicitly creating an administrator (npm run db:seed).
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# V2 background storage. Server-only; NEVER prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=""
